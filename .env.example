# Database. Local dev uses a SQLite file; in production point this at a
# hosted libSQL/Turso database (libsql://...) and set DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/3i-forum.db
DATABASE_AUTH_TOKEN=

# Secret for signing form tokens and hashing IPs. At least 32 characters.
# Generate with: openssl rand -base64 48
APP_SECRET=

# Set to true only behind a proxy/CDN you control (Vercel, Cloudflare, nginx)
# so the client IP from X-Forwarded-For can be trusted for rate limiting.
TRUST_PROXY=false

# Keep this stable across deploys/instances when self-hosting.
# Generate with: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
